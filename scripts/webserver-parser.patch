 bool WebServer::_parseForm(NetworkClient &client, const String &boundary, uint32_t len) {
+  if (_currentMethod == HTTP_POST && _currentUri == "/upload") {
+    uint32_t consumed = 0;
+    auto read = [&]() {
+      if (len && consumed == len) return -1;
+      int c = _uploadReadByte(client);
+      if (c >= 0) ++consumed;
+      return c;
+    };
+    log_v("Parse Form: Boundary: %s Length: %" PRIu32, boundary.c_str(), len);
+    String line;
+    int retry = 0;
+    do {
+      if (!upload_ingress::readHeaderLine(line, read)) return false;
+      ++retry;
+    } while (line.length() == 0 && retry < 3);
+
+    //start reading the form
+    auto delimiter = [&](bool last) {
+      unsigned int length = boundary.length();
+      return line.length() == 2 + length + (last ? 2 : 0) && line.startsWith("--") &&
+             memcmp(line.c_str() + 2, boundary.c_str(), length) == 0 &&
+             (!last || line.endsWith("--"));
+    };
+    if (delimiter(false)) {
+      if (_postArgs) {
+        delete[] _postArgs;
+      }
+      _postArgs = nullptr;
+      _postArgsLen = 0;
+      unsigned int textFields = 0;
+      while (1) {
+        String argName;
+        String argValue;
+        String argType;
+        String argFilename;
+        bool argIsFile = false;
+
+        if (!upload_ingress::readHeaderLine(line, read)) return false;
+        if (strncasecmp(line.c_str(), "Content-Disposition:", 20) != 0 ||
+            !upload_ingress::parseDisposition(line.c_str() + 20, argName, argFilename, argIsFile)) return false;
+        if (argIsFile && argFilename == F("blob") && hasArg(FPSTR(filename))) {
+          String overrideName = arg(FPSTR(filename));
+          if (!overrideName.c_str() || !overrideName.length()) return false;
+          argFilename = std::move(overrideName);
+        }
+        log_v("PostArg Name: %s", argName.c_str());
+        using namespace mime;
+        argType = FPSTR(mimeTable[txt].mimeType);
+        if (!upload_ingress::readHeaderLine(line, read)) return false;
+        while (line.length() > 0) {
+          if (strncasecmp(line.c_str(), "Content-Disposition:", 20) == 0) return false;
+          if (line.length() > (size_t)12 && strncasecmp(line.c_str(), Content_Type, 12) == 0) {
+            argType = line.substring(line.indexOf(':') + 2);
+          }
+          //skip over any other headers
+          if (!upload_ingress::readHeaderLine(line, read)) return false;
+        }
+        log_v("PostArg Type: %s", argType.c_str());
+        if (!argIsFile) {
+          while (1) {
+            bool endedAtEof = false;
+            if (!upload_ingress::readHeaderLine(line, read, true, &endedAtEof) &&
+                !(endedAtEof && len && consumed == len && delimiter(true))) return false;
+            if (delimiter(false) || delimiter(true)) {
+              break;
+            }
+            if (argValue.length() + line.length() + (argValue.length() != 0) > upload_ingress::MAX_METADATA_BYTES) return false;
+            if (argValue.length() > (size_t)0) {
+              if (!argValue.concat('\n')) return false;
+            }
+            if (!argValue.concat(line)) return false;
+          }
+          log_v("PostArg Value: %s", argValue.c_str());
+
+          ++textFields;
+          if (delimiter(true)) {
+            log_v("Done Parsing POST");
+            break;
+          } else if (textFields >= WEBSERVER_MAX_POST_ARGS) {
+            log_e("Too many PostArgs (max: %u) in request.", WEBSERVER_MAX_POST_ARGS);
+            return false;
+          }
+        } else {
+          _currentUpload.reset(new (std::nothrow) HTTPUpload());
+          if (!_currentUpload) return false;
+          _currentUpload->status = UPLOAD_FILE_START;
+          _currentUpload->name = std::move(argName);
+          _currentUpload->filename = std::move(argFilename);
+          _currentUpload->type = std::move(argType);
+          _currentUpload->totalSize = 0;
+          _currentUpload->currentSize = 0;
+          log_v("Start File: %s Type: %s", _currentUpload->filename.c_str(), _currentUpload->type.c_str());
+          if (_currentHandler && _currentHandler->canUpload(*this, _currentUri)) {
+            _currentHandler->upload(*this, _currentUri, *_currentUpload);
+          }
+          _currentUpload->status = UPLOAD_FILE_WRITE;
+
+          int fastBoundaryLen = 4 /* \r\n-- */ + boundary.length() + 1 /* \0 */;
+          char fastBoundary[fastBoundaryLen];
+          snprintf(fastBoundary, fastBoundaryLen, "\r\n--%s", boundary.c_str());
+          int boundaryPtr = 0;
+          while (true) {
+            int ret = read();
+            if (ret < 0) {
+              // Unexpected, we should have had data available per above
+              return _parseFormUploadAborted();
+            }
+            char in = (char)ret;
+            if (in == fastBoundary[boundaryPtr]) {
+              // The input matched the current expected character, advance and possibly exit this file
+              boundaryPtr++;
+              if (boundaryPtr == fastBoundaryLen - 1) {
+                // We read the whole boundary line, we're done here!
+                break;
+              }
+            } else {
+              // The char doesn't match what we want, so dump whatever matches we had, the read in char, and reset ptr to start
+              for (int i = 0; i < boundaryPtr; i++) {
+                _uploadWriteByte(fastBoundary[i]);
+              }
+              if (in == fastBoundary[0]) {
+                // This could be the start of the real end, mark it so and don't emit/skip it
+                boundaryPtr = 1;
+              } else {
+                // Not the 1st char of our pattern, so emit and ignore
+                _uploadWriteByte(in);
+                boundaryPtr = 0;
+              }
+            }
