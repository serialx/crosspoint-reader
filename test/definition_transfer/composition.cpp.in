#include <array>
#include <cassert>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <string>
#include <span>
#include <Memory.h>
#include <vector>
#include <xp_app.h>
#include <xp_epub_session.h>
#include "app_leaves.h"
#include "physical_defaults.h"
#include "activities/ActivityResult.h"

extern "C" {
uint8_t xp_app_test_install_definition(XpAppText, uint32_t, XpEpubDefinitionFill, void*);
uint8_t xp_app_test_drain();
void* xp_app_test_published_legacy();
void xp_test_fail_allocation_after(size_t);
size_t xp_test_allocation_attempts();
}
static std::vector<std::string> events;
static bool locked, tracing, childLive, rejectText, reenter, decline, declineSink, reenterPop;
static void home();
static unsigned pages, allocated, freed;
static uint8_t* lastAllocation;
static void* parentHandle;
static void record(const char* event) { if (tracing) events.emplace_back(event); }
static void* allocateText(size_t bytes) {
  assert(!childLive && pages == 0 && locked);
  record("text-allocation"); ++allocated;
  if (rejectText) return nullptr;
  return lastAllocation = static_cast<uint8_t*>(std::malloc(bytes));
}
static void freeText(void* data) { ++freed; std::free(data); }
#define malloc allocateText
#define free freeText
#include "activities/reader/DefinitionQuery.h"
#undef malloc
#undef free
static void lockRender() { assert(!locked); locked = true; }
static void unlockRender() {
  assert(locked);
  if (tracing && childLive == false && pages > 0 && xp_app_test_current_legacy() == parentHandle) {
    assert(xp_app_test_published_legacy() == parentHandle);
    record("parent-publish"); record("pop-unlock");
  }
  locked = false;
  if (tracing && reenterPop && !childLive && pages > 0 && xp_app_test_current_legacy() == parentHandle) {
    reenterPop = false;
    home();
  }
}
struct RenderLock { RenderLock() { lockRender(); } ~RenderLock() { unlockRender(); } };
struct Page {
  Page() { ++pages; }
  ~Page() { assert(!childLive); --pages; record("page-release"); }
};
struct Dictionary {};
struct Activity {
  ActivityResult result;
  virtual ~Activity() = default;
};
struct ClipSelectionActivity : Activity {
// SELECTION
  template<class... Args> explicit ClipSelectionActivity(Args&&...) { assert(pages); childLive = true; }
  ~ClipSelectionActivity() override { assert(pages); childLive = false; record("child-drop"); }
};
static bool rejectChild, rejectWrapper, rejectAdoption;
static size_t wrapperSize;
static unsigned childAllocationFailures;
void* operator new(size_t bytes, const std::nothrow_t&) noexcept {
  if (rejectChild && bytes == sizeof(ClipSelectionActivity)) { ++childAllocationFailures; return nullptr; }
  if (rejectWrapper && bytes == wrapperSize) return nullptr;
  return ::operator new(bytes);
}
enum class StrId { STR_DICT_HISTORY_FULL, STR_DICT_LOW_MEMORY };
struct HalMemory {
  struct Heap { size_t freeBytes, largestBlockBytes; };
  static inline Heap heap{1024*1024, 1024*1024};
  static Heap getDefaultHeap() { record("heap-check"); return heap; }
};
constexpr size_t HEAP_HEADROOM = 8192;
constexpr size_t SELECTION_PAGE_WINDOW = 3;
#define LOG_ERR(...) record("low-heap-log")
// OWNED_NATIVE_DECLARATION
// OWNED_NATIVE_FACTORY
// NATIVE_ACTIVITY_GETTER
static XpAppEventResult selectionEvent(const XpAppEvent* event) {
  return rejectAdoption ? XP_APP_REJECTED : xp_app_event(event);
}
struct DictionaryDefinitionActivity : Activity {
// STRUCTS
  Definition content;
  std::unique_ptr<LookupState> lookup;
  StrId message{};
  unsigned messages = 0;
  void showMessage(StrId next) { message = next; ++messages; record("message"); }
  XpDefinitionSelection prepareSelectionResult(const ActivityResult&);
  uint8_t acceptSelectionResult(XpDefinitionSelection);
  void selectionInstallFailed();
  int renderer = 0, mappedInput = 0;
  bool rustSceneRejected() const { return false; }
  void requestUpdate() {}
  BodyArea bodyArea() const { return {0, 0, 20, 20}; }
  bool buildPlainSelectionPages() { return true; }
  void startSelection(int x = -1, int y = -1);
  ~DictionaryDefinitionActivity() override { assert(!childLive); record("definition-drop"); }
};
// PREPARATION
// ACCEPTANCE
// START_SELECTION
// FAILED_INSTALL
static Dictionary dictionary;
struct ResultLifetime { ~ResultLifetime() { record("native-result-drop"); } };
static XpAppLegacy legacy = appTestLegacy();
static XpAppResources resources = appTestResources();
static XpAppRuntime runtime = appTestRuntime();
static XpEpubLeaves epub = unexpectedEpubLeaves();
static XpAppCompatibility compatibility{};
static auto nativeBridge = // BRIDGE
;
static auto nativeAccept = // NATIVE_ACCEPT
;
static auto nativeFailed = // NATIVE_FAILED
;
static void home() {
  XpAppEvent event{.kind = XP_APP_HOME_REQUESTED};
  assert(xp_app_event(&event) == XP_APP_ACCEPTED);
  assert(xp_app_test_drain());
  assert(xp_app_test_is_home());
}
static void configure() {
  runtime.render_lock = []() -> void* { lockRender(); return &locked; };
  runtime.render_unlock = [](void*) { unlockRender(); };
  runtime.ble_before_screen_change = [](uint8_t) -> uint8_t { return 1; };
  runtime.diagnostic = [](uint8_t tag, uint32_t, uint32_t) { if (tag == 2) record("stack-failure"); };
  legacy.destroy = [](void* child) { delete static_cast<OwnedLegacyActivity*>(child); };
  legacy.exit = [](void* handle) { if (handle != parentHandle) record("child-exit"); };
  legacy.with_definition_selection_result = [](void* child, XpDefinitionPop pop, XpDefinitionSelectionSink sink, void* context) {
    struct Context { XpDefinitionPop pop; XpDefinitionSelectionSink sink; void* context; } state{pop, sink, context};
    nativeBridge(child,
      [](void* raw) -> void* {
        auto& state = *static_cast<Context*>(raw);
        return state.pop(state.context);
      },
      [](void* raw, void* parent, XpDefinitionSelection result) -> uint8_t {
        auto& state = *static_cast<Context*>(raw);
        if (result.text.len) assert(result.text.data == lastAllocation);
        assert(!childLive && pages == 0 && locked);
        if (declineSink) return 0;
        record("rust-move");
        return state.sink(state.context, parent, result);
      }, &state);
  };
  legacy.deliver_definition_selection_result = [](void* parent, XpDefinitionSelection result) -> uint8_t {
    record("native-move");
    if (decline) return 0;
    const auto accepted = nativeAccept(parent, result);
    // Destruction is legal here: no native parent reference survives the bridge call.
    if (reenter) {
      // Real Home replacement needs an unlocked boundary; the separate Rust Miri
      // witness destroys its parent synchronously at the owned-result sink.
      XpAppEvent event{.kind = XP_APP_HOME_REQUESTED};
      assert(xp_app_event(&event) == XP_APP_ACCEPTED);
    }
    return accepted;
  };
  legacy.definition_selection_install_failed = nativeFailed;
  epub.clipping_physical = nullptr;
  epub.child_definition_plain = [](XpEpubDefinitionStorage* storage, XpAppText, uint32_t,
      XpEpubDefinitionFill, void*) -> void* {
    auto activity = std::make_unique<DictionaryDefinitionActivity>();
    activity->lookup = std::make_unique<DictionaryDefinitionActivity::LookupState>(dictionary);
    auto* wrapper = ::new (storage) OwnedLegacyActivity(std::move(activity));
    return wrapper;
  };
  epub.child_definition_drop = [](XpEpubDefinitionStorage* storage) {
    std::destroy_at(reinterpret_cast<OwnedLegacyActivity*>(storage));
  };
  XpAppPlatform platform{&legacy, &resources, &runtime, &epub};
  assert(xp_app_init(&platform, &compatibility) == XP_APP_OK);
}
int main(int argc, char** argv) {
  assert(argc == 5);
  const std::string mode = argv[1];
  const size_t length = std::stoul(argv[2]);
  const unsigned depth = std::stoul(argv[3]);
  const bool cancelled = std::stoi(argv[4]);
  configure();
  if (mode == "home-retained") home();
  assert(xp_app_test_install_definition({}, 0, [](void*, uint8_t*, uint32_t) -> uint8_t { return 1; }, nullptr));
  assert(xp_app_test_drain());
  parentHandle = xp_app_test_current_legacy();
  assert(parentHandle);
  auto* parent = static_cast<DictionaryDefinitionActivity*>(nativeActivity(parentHandle));
  parent->lookup->depth = depth;
  parent->content.selectionPage = 4;
  parent->content.selection.valid = true;
  const char* retainedPointer = nullptr;
  if (mode == "retained-failure" || mode == "retained-reuse") {
    RenderLock lock;
    OwnedSelectionText retained;
    assert(retained.assign(mode == "retained-reuse" ? std::string(4096, 'z') : std::string("old")));
    if (mode == "retained-reuse") retained.clear();
    retainedPointer = retained.c_str();
    parent->lookup->pendingWord = std::move(retained);
  }
  parent->lookup->selectionPages.push_back(std::make_unique<Page>());
  if (mode == "wrapper-allocation" || mode == "adoption-failure") {
    wrapperSize = sizeof(OwnedLegacyActivity);
    rejectWrapper = mode == "wrapper-allocation"; rejectAdoption = !rejectWrapper; tracing = true;
    parent->startSelection();
    rejectWrapper = rejectAdoption = tracing = false;
    assert(!childLive && !pages && !allocated);
    assert(parent->messages == 1 && parent->message == StrId::STR_DICT_LOW_MEMORY);
    auto expected = std::vector<std::string>{"child-drop", "page-release", "message"};
    if (mode == "wrapper-allocation") expected.insert(expected.begin(), "low-heap-log");
    assert(events == expected);
    home(); return 0;
  }
  if (mode == "child-allocation") {
    rejectChild = true; tracing = true;
    parent->startSelection();
    rejectChild = false; tracing = false;
    assert(childAllocationFailures == 1 && !pages && !childLive && !allocated);
    assert(parent->messages == 1 && parent->message == StrId::STR_DICT_LOW_MEMORY);
    assert(events == std::vector<std::string>({"low-heap-log", "page-release", "message"}));
    home(); return 0;
  }
  if (mode == "home-current") {
    tracing = true; home(); tracing = false;
    assert(!pages && !allocated && !childLive);
    return 0;
  }
  // Fresh App parent vector has capacity four. Force its next real reserve at 4.
  std::vector<OwnedLegacyActivity*> fillers;
  if (mode == "stack-failure") {
    for (int i = 0; i < 4; ++i) {
      assert(xp_app_test_install_definition({}, 0, [](void*, uint8_t*, uint32_t) -> uint8_t { return 1; }, nullptr));
      assert(xp_app_test_drain());
    }
    // The rejected child borrows this current parent's temporary Page.
    parent->lookup->selectionPages.clear();
    parentHandle = xp_app_test_current_legacy();
    parent = static_cast<DictionaryDefinitionActivity*>(nativeActivity(parentHandle));
    parent->lookup->selectionPages.push_back(std::make_unique<Page>());
  }
  parent->startSelection();
  assert(xp_app_test_pending_kind() == 1);
  if (mode == "stack-failure") xp_test_fail_allocation_after(0);
  tracing = mode == "stack-failure";
  assert(xp_app_test_drain());
  if (mode == "stack-failure") {
    assert(xp_test_allocation_attempts() == 1);
    xp_test_fail_allocation_after(SIZE_MAX);
    assert(!childLive && !pages && !allocated);
    assert(parent->messages == 1 && parent->message == StrId::STR_DICT_LOW_MEMORY);
    assert(events == std::vector<std::string>({"stack-failure", "child-drop", "page-release", "message"}));
    tracing = false; home(); return 0;
  }
  if (mode == "home-retained") {
    tracing = true; home(); tracing = false;
    assert(!pages && !childLive && !allocated); return 0;
  }
  auto* childHandle = xp_app_test_current_legacy();
  assert(childHandle && childHandle != parentHandle);
  ClippingResult selected;
  selected.text = std::string(length, 'x');
  selected.startPageOffset = 1; selected.endPageOffset = 2;
  selected.startWordIndex = 3; selected.endWordIndex = 4;
  nativeActivity(childHandle)->result = ActivityResult(std::move(selected));
  nativeActivity(childHandle)->result.isCancelled = cancelled;
  if (mode == "heap") HalMemory::heap = {length, length};
  rejectText = mode == "allocation" || mode == "retained-failure";
  decline = mode == "decline";
  declineSink = mode == "decline-sink";
  reenterPop = mode == "reenter-pop";
  reenter = mode == "reenter";
  events.clear(); tracing = true;
  XpAppEvent pop{.kind = XP_APP_POP}; assert(xp_app_event(&pop) == XP_APP_ACCEPTED);
  assert(xp_app_test_drain());
  tracing = false;
  assert(!childLive && !pages);
  std::vector<std::string> expected{"native-take", "child-exit", "child-drop", "parent-publish", "pop-unlock", "page-release"};
  if (mode == "reenter-pop") {
    expected = {"native-take", "child-exit", "child-drop", "parent-publish", "pop-unlock", "definition-drop", "page-release", "native-result-drop"};
    if (events != expected) { for (auto& e:events) std::fprintf(stderr, "%s\n", e.c_str()); return 2; }
    assert(!allocated && xp_app_test_is_home()); return 0;
  }
  if (!cancelled) {
    expected.push_back("decision");
    if (depth == 16) expected.push_back("message");
    else {
      expected.push_back("heap-check");
      if (mode != "heap" && mode != "retained-reuse" && length) expected.push_back("text-allocation");
      if (mode == "heap" || rejectText) {
        expected.push_back("low-heap-log"); expected.push_back("message");
      }
    }
  }
  if (!declineSink) { expected.push_back("rust-move"); expected.push_back("native-move"); }
  expected.push_back("native-result-drop");
  if (reenter) expected.push_back("definition-drop");
  if (events != expected) { for (auto& e:events) std::fprintf(stderr, "%s\n",e.c_str()); return 2; }
  if (!reenter) {
    assert(parent->content.currentPage == (cancelled ? 0 : 6));
    const bool success = !cancelled && depth < 16 && mode != "heap" && !rejectText && !decline && !declineSink;
    assert(std::strlen(parent->lookup->pendingWord.c_str()) == (success ? length : (mode == "retained-failure" ? 3 : 0)));
    if (retainedPointer) assert(parent->lookup->pendingWord.c_str() == retainedPointer);
    if (success) {
      auto* data = parent->lookup->pendingWord.c_str();
      parent->lookup->query = std::move(parent->lookup->pendingWord);
      parent->lookup->history[0].query = std::move(parent->lookup->query);
      parent->lookup->query = std::move(parent->lookup->history[0].query);
      assert(parent->lookup->query.c_str() == data);
    }
    home();
  }
  assert(freed == allocated - (rejectText ? 1 : 0));
  std::printf("%s len=%zu depth=%u cancelled=%u allocations=%u frees=%u holder=%zu string=%zu\n",mode.c_str(), length, depth, cancelled, allocated, freed, sizeof(DefinitionQuery), sizeof(std::string));
}
