#include <xp_epub_session.h>
#include <memory>
#include <vector>
#include "components/icons/customListIcons.h"
#include "components/icons/listIcons.h"
#define LOG_ERR(...) do { assert(false && "native oracle I/O failure"); } while (0)
template<class T> std::unique_ptr<T> makeUniqueNoThrow(size_t count) { return std::make_unique<T>(count); }
@NATIVE_CLASSES@
struct ModelLock { template<class T> explicit ModelLock(T&) {} };
struct ReaderChromeListActivity {
  GfxRenderer& renderer;
  MappedInputManager& mappedInput;
  const XpUiReaderListKind kind = XP_UI_READER_BOOKMARKS;
  const uint16_t rowCapacity = @ROW_CAPACITY@;
  fui::GfxRendererTarget textTarget;
  XpUiReaderListState state{};
  int32_t renderingScroll = 0;
  struct { ReaderChromeCommands commands; XpUiReaderListState next{}; XpUiReaderTheme theme{}; XpUiReaderHitLayout nextHits{}; } arena;
  ReaderChromeListActivity(GfxRenderer& r, MappedInputManager& input) : renderer(r), mappedInput(input), textTarget(makeUiTarget(r)) {
    xp_ui_reader_list_init(&state, 0); assert(arena.commands.reserve(@COMMAND_START@));
  }
  virtual ~ReaderChromeListActivity() = default;
  virtual int listCount() const = 0;
  virtual void prepareRows(int) = 0;
  virtual const ReaderChromeRow* rowAt(int) const = 0;
  virtual const char* headerTitle() const = 0;
  virtual const char* emptyText() const = 0;
  virtual const char* helpText() const = 0;
  const char* progressText() const { return ""; }
  const char* text(uint32_t) const;
  XpUiReaderRows rows();
  XpUiPaint rustResources();
  bool buildRustScene(XpUiScene&);
  virtual void drawFooter() = 0;
};
struct FixtureEpub {
  struct Item { std::string title; };
  std::vector<Item> titles;
  int getTocIndexForSpineIndex(uint16_t spine) const { return spine % 4 == 0 ? -1 : spine; }
  const Item& getTocItem(int index) const { return titles.at(index); }
};
static std::shared_ptr<FixtureEpub> BOOK;
static std::vector<BookmarkEntry> RECORDS;
struct EpubReaderBookmarksActivity : ReaderChromeListActivity {
  std::shared_ptr<FixtureEpub> epub = BOOK;
  std::vector<BookmarkEntry> bookmarks = RECORDS;
  std::vector<std::string> bookmarkSubtitles;
  std::vector<ReaderChromeRow> bookmarkRowItems;
  EpubReaderBookmarksActivity(GfxRenderer& r) : ReaderChromeListActivity(r, ::mappedInput) { rebuildBookmarkRowItems(); }
  @GETTERS@
  void prepareRows(int) override {}
  void rebuildBookmarkRowItems();
  void drawFooter() override;
  const ReaderChromeRow* rowAt(int) const override;
};
static GfxRenderer* target;
static const char* pathText(XpAppText text) { assert(!text.len || text.data[text.len] == 0); return text.len ? reinterpret_cast<const char*>(text.data) : ""; }
@METHODS@
extern "C" {
void* xp_epub_test_bookmark_open(const XpAppRuntime*, XpAppText);
void xp_epub_test_bookmark_close(void*);
uint16_t xp_epub_test_bookmark_render(void*, const XpAppResources*, const XpEpubLeaves*, int32_t, int32_t,
                                    void (*)(uint8_t, XpUiRect, XpUiRect, uint8_t),
                                    uint8_t (*)(uint16_t, XpAppTextSink, void*), XpUiReaderListState*);
}
static XpAppResources bookmarkResources() {
  auto r = percentResources();
  r.text_width = [](XpAppText text, int32_t font, uint8_t style) -> int32_t {
    return adapterRenderer->getTextWidth(font, pathText(text), static_cast<EpdFontFamily::Style>(style));
  };
  r.footer_draw = [](const XpAppText* labels) {
    auto mapped = mappedInput.mapLabels(pathText(labels[0]), pathText(labels[1]), pathText(labels[2]), pathText(labels[3]));
    GUI.drawButtonHints(*target, mapped.btn1, mapped.btn2, mapped.btn3, mapped.btn4);
  };
  r.popup_draw = [](XpAppText) -> XpUiRect { return {}; };
  r.buffer_allocate = [](XpAppMemoryDomain, size_t bytes) -> uint8_t* { return static_cast<uint8_t*>(std::malloc(bytes)); };
  r.buffer_release = [](XpAppMemoryDomain, uint8_t* data) { std::free(data); };
  return r;
}
static uint8_t fixtureTitle(uint16_t spine, XpAppTextSink sink, void* context) {
  const auto index = BOOK->getTocIndexForSpineIndex(spine);
  const auto title = index < 0 ? std::string(tr(STR_UNNAMED)) : BOOK->getTocItem(index).title;
  return sink(context, {reinterpret_cast<const uint8_t*>(title.c_str()), title.size()});
}
static std::string fixtureRecords(unsigned count) {
  BOOK = std::make_shared<FixtureEpub>(); BOOK->titles.resize(count);
  RECORDS.clear(); RECORDS.resize(count);
  std::string json = "{\"bookmarks\":[";
  for (unsigned i = 0; i < count; ++i) {
    auto& row = RECORDS[i];
    row.summary = i % 3 == 0 ? "" : i % 3 == 1 ? "Korean 한국어 and a long sentence with spaces for wrapping." : std::string(256,'w');
    row.name = i % 3 == 2 ? "A renamed bookmark" : "";
    row.percentage = i % 3 == 0 ? 0.505f : i % 3 == 1 ? -1.0f : 1.5f;
    row.computedSpineIndex = i;
    row.computedChapterPageCount = i % 2 ? 10 : 0;
    row.computedChapterProgress = i % 3;
    BOOK->titles[i].title = i % 5 == 0 ? "" : "Chapter " + std::to_string(i) + ": a long chapter title";
    if (i) json += ',';
    json += "{\"summary\":\"" + row.summary + "\",\"name\":\"" + row.name + "\",\"percentage\":" + std::to_string(row.percentage)
          + ",\"si\":" + std::to_string(i) + ",\"pc\":" + std::to_string(row.computedChapterPageCount) + ",\"pp\":" + std::to_string(row.computedChapterProgress) + "}";
  }
  return json + "]}";
}
int main(int argc, char** argv) {
  HalDisplay display;
  GfxRenderer renderer(display);
  renderer.begin(); target = adapterRenderer = &renderer;
  static const auto runtime = appTestRuntime();
  static const auto resources = bookmarkResources();
  static XpEpubLeaves leaves{};
  leaves.child_list_theme = [](XpUiReaderTheme* theme, XpUiReaderThemeFacts* facts, uint8_t toolbar) { sampleReaderChildTheme(*target, *theme, *facts, toolbar); };
  leaves.child_header = [](XpUiRect bounds, XpAppText text, uint8_t list) { drawReaderHeader(*target, bounds, text, list); };
  leaves.child_list_help = candidateHelp;
  auto icon = +candidateIcon;
  const std::string negative = argc > 1 ? argv[1] : "";
  if (negative == "help-offset") leaves.child_list_help = [](XpUiRect rect, XpAppText text) { ++rect.y; candidateHelp(rect,text); };
  if (negative == "icon-tint") icon = [](uint8_t kind, XpUiRect rect, XpUiRect clip, uint8_t paint) { candidateIcon(kind,rect,clip,paint^1); };
  if (negative == "icon-offset") icon = [](uint8_t kind, XpUiRect rect, XpUiRect clip, uint8_t paint) { ++rect.x; candidateIcon(kind,rect,clip,paint); };
  if (negative == "trash-kind") icon = [](uint8_t, XpUiRect rect, XpUiRect clip, uint8_t paint) { candidateIcon(0,rect,clip,paint); };
  static EpdFont small(&ubuntu_10_regular), smallBold(&ubuntu_10_bold), body(&ubuntu_12_regular), bodyBold(&ubuntu_12_bold),
      title(&notosans_18_regular), titleBold(&notosans_18_bold), tiny(&ubuntu_8_regular);
  renderer.insertFont(SMALL_FONT_ID, EpdFontFamily(&tiny));
  renderer.insertFont(UI_10_FONT_ID, EpdFontFamily(&small, &smallBold));
  renderer.insertFont(UI_12_FONT_ID, EpdFontFamily(&body, &bodyBold));
  renderer.insertFont(NOTOSANS_18_FONT_ID, EpdFontFamily(&title, &titleBold));
  FontDecompressor decompressor; assert(decompressor.init());
  FontCacheManager cache(renderer.getFontMap(), renderer.getSdCardFonts(), renderer.getTtfFonts());
  cache.setFontDecompressor(&decompressor); renderer.setFontCacheManager(&cache);
  unsigned cases = 0;
  const ThemeMetrics themes[] = {BaseMetrics::values, RoundedRaffMetrics::values, LyraMetrics::values};
  for (nativeTheme = 0; nativeTheme < 3; ++nativeTheme)
  for (bool inverted : {false, true})
  for (int orientation = 0; orientation < 4; ++orientation)
  for (bool touch : {false, true})
  for (unsigned count : {0,1,24,25,64}) {
    display.inverted = inverted; BoardConfig::touch = touch;
    UITheme::getInstance().metrics = themes[nativeTheme];
    renderer.setOrientation(static_cast<GfxRenderer::Orientation>(orientation));
    const auto json = fixtureRecords(count);
    for (int selected : {0, static_cast<int>(count)/2, std::max(0,static_cast<int>(count)-1)}) {
      for (bool reveal : {false, true}) {
      EpubReaderBookmarksActivity native(renderer);
      xp_ui_reader_list_select(&native.state, selected, count);
      native.state.revealed = reveal && touch && count ? selected : -1;
      renderer.setClipRect(0,0,renderer.getScreenWidth(),renderer.getScreenHeight());
      display.pixels.fill(0xa5);
      XpUiScene scene{}; assert(native.buildRustScene(scene));
      const auto paint = native.rustResources(); assert(renderer.drawUiScene(scene, &paint));
      const auto expected = display.pixels;
      void* owned = xp_epub_test_bookmark_open(&runtime, {reinterpret_cast<const uint8_t*>(json.data()), json.size()});
      display.pixels.fill(0xa5);
      XpUiReaderListState result{};
      assert(xp_epub_test_bookmark_render(owned, &resources, &leaves, selected, native.state.revealed, icon, fixtureTitle, &result) <= 128);
      if (expected != display.pixels) {
        std::fprintf(stderr, "pixel mismatch theme=%u inverted=%d orientation=%d touch=%d count=%u selected=%d\n", nativeTheme,inverted,orientation,touch,count,selected);
        return 1;
      }
      assert(result.list.top == native.arena.next.list.top);
      assert(result.list.selected == native.arena.next.list.selected);
      assert(result.list.drawn == native.arena.next.list.drawn);
      xp_epub_test_bookmark_close(owned);
      ++cases;
      }
    }
  }
  std::printf("bookmark native/owned pixel parity: %u cases\n", cases);
}
