#include <xp_settings.h>

#include <algorithm>
#include <cassert>
#include <cstdio>
#include <cstring>

#include "owner_tables.h"

struct CrossPointSettings {
  uint8_t orientation = 0, fontPointSize = 0, lineSpacing = 0, paragraphAlignment = 0;
  uint8_t focusReadingEnabled = 0, screenMargin = 0, textAntiAliasing = 0, embeddedStyle = 0;
  uint8_t removeReadBooksFromRecents = 0, moveFinishedToReadFolder = 0, readerMenuStyle = 0;
  uint8_t longPressMenuFunction = 0, longPressButtonBehavior = 0, shortPwrBtn = 0, tiltPageTurn = 0;
  uint8_t touchReaderControls = 0, pageTurnGesture = 0, previousPageGesture = 0, showReaderMenu = 0;
  uint8_t backShortToFileBrowser = 0, screenInverted = 0, refreshFrequency = 0;
  struct {
    uint8_t enabled = 0;
  } ble;
  char dictionaryName[1]{}, sdFontFamilyName[1]{};
  int getReaderFontId() const { return 24; }
  int getRefreshFrequency() const;
} SETTINGS;
// ACTUAL_GETTER
static XpAppText text(const char* value) { return {reinterpret_cast<const uint8_t*>(value), std::strlen(value)}; }
static auto snapshot = /* ACTUAL_SNAPSHOT */;
static unsigned snapshots = 0, live = 0;
static char bookmark, popup;
extern "C" void* xp_epub_test_frequency_create(const XpEpubLeaves*, const XpAppRuntime*, const XpAppResources*,
                                               uint8_t);
extern "C" int32_t xp_epub_test_frequency_read(void*, int32_t*);
extern "C" void xp_epub_test_frequency_destroy(void*);
int main() {
  static const auto resources = retirement_fixture::resourcesDefaults();
  static const auto runtime = retirement_fixture::modelRuntime();
  static const auto leaves = [] {
    auto table = retirement_fixture::leavesDefaults();
    table.settings_snapshot = [](uint8_t font, XpEpubSettings* out) {
      ++snapshots;
      snapshot(font, out);
    };
    table.bookmarks_open = []() -> void* {
      ++live;
      return &bookmark;
    };
    table.bookmarks_close = [](void* p) {
      assert(p == &bookmark);
      --live;
    };
    table.popup_open = []() -> void* {
      ++live;
      return &popup;
    };
    table.popup_close = [](void* p) {
      assert(p == &popup);
      --live;
    };
    return table;
  }();
  for (unsigned raw = 0; raw != 256; ++raw) {
    for (uint8_t fast : {0, 1}) {
      SETTINGS.refreshFrequency = raw;
      const int initial = fast ? std::max(2, SETTINGS.getRefreshFrequency()) : 0;
      snapshots = 0;
      void* owner = xp_epub_test_frequency_create(&leaves, &runtime, &resources, fast);
      assert(owner && live == 3 && snapshots == fast);
      for (unsigned change = 0; change != 3; ++change) {
        // Entry, a reader-menu edit and return from Settings all read live input.
        SETTINGS.refreshFrequency = static_cast<uint8_t>(raw + change);
        int32_t counter = -1;
        const unsigned before = snapshots;
        assert(xp_epub_test_frequency_read(owner, &counter) == SETTINGS.getRefreshFrequency());
        assert(snapshots == before + 1 && counter == initial);
      }
      xp_epub_test_frequency_destroy(owner);
      assert(live == 0);
    }
  }
  std::puts("256 raw settings, 512 real-session entries, 1536 fresh reads; fast max(2) exact");
}
