// Real session/RenderContext composition, using the physical adapters above.
#include "owner_tables.h"
extern "C" uint8_t xp_epub_test_session_render(const XpAppResources*, const XpEpubLeaves*, const XpAppRuntime*,
                                               XpAppText, uint8_t);
namespace {
struct SessionChecks {
  GfxRenderer* renderer = nullptr;
  std::array<void*, 12> live{};
  size_t requests = 0, failAt = SIZE_MAX;
  unsigned handles = 0, paints = 0, statuses = 0;
} sessionChecks;
const XpAppResources sessionMemory = [] {
  auto table = retirement_fixture::resourcesDefaults();
  table.buffer_allocate = [](uint8_t domain, size_t bytes) -> uint8_t* {
    assert(domain == XP_APP_MEMORY_DEFAULT);
    if (sessionChecks.requests++ == sessionChecks.failAt) return nullptr;
    auto* pointer = static_cast<uint8_t*>(std::malloc(bytes));
    assert(pointer);
    for (auto& slot : sessionChecks.live)
      if (!slot) {
        slot = pointer;
        return pointer;
      }
    std::abort();
  };
  table.buffer_release = [](uint8_t domain, uint8_t* pointer) {
    assert(domain == XP_APP_MEMORY_DEFAULT && !display.source && !frameChecks::window);
    for (auto& slot : sessionChecks.live)
      if (slot == pointer) {
        slot = nullptr;
        std::free(pointer);
        return;
      }
    std::abort();
  };
  return table;
}();
const XpAppRuntime sessionRuntime = [] {
  auto table = retirement_fixture::modelRuntime();
  table.now_ms = []() -> uint32_t {
    assert(!retirement_fixture::modelDepth);
    return 0;
  };
  return table;
}();
}  // namespace
void testRealSession(const XpEpubLeaves& pageLeaves, XpAppText wire, GfxRenderer& renderer, bool faults) {
  static XpEpubLeaves leaves;
  leaves = pageLeaves;
  leaves.bookmarks_open = []() -> void* {
    ++sessionChecks.handles;
    return &sessionChecks;
  };
  leaves.bookmarks_close = [](void* p) {
    assert(p == &sessionChecks);
    --sessionChecks.handles;
  };
  leaves.popup_open = leaves.bookmarks_open;
  leaves.popup_close = leaves.bookmarks_close;
  leaves.settings_snapshot = [](uint8_t, XpEpubSettings* out) {
    *out = {};
    out->font = 24;
  };
  leaves.render_geometry = [](XpEpubGeometry* out) {
    *out = {};
    out->width = 800;
    out->height = 800;
    out->title_mode = 2;
  };
  leaves.radio_status = [](XpEpubRadio* out, XpEpubPeer* peer) {
    *out = {};
    if (peer) *peer = {};
  };
  leaves.render_physical_query = [](uint8_t query) { return physicalRenderQuery(*sessionChecks.renderer, query); };
  leaves.render_physical_operation = [](const XpEpubPhysicalOp* op) {
    assert(!retirement_fixture::modelDepth);
    return physicalRenderOperation(*sessionChecks.renderer, *op);
  };
  leaves.render_plan = [](XpPagePlan* plan, XpPageRowBounds* bounds, uint16_t count, uint8_t record) {
#if defined(XP_STRIP_RENDER) && XP_STRIP_RENDER
    physicalRenderPlan(*sessionChecks.renderer, plan, bounds, count, record);
#else
    (void)plan;
    (void)bounds;
    (void)count;
    (void)record;
#endif
  };
  leaves.image_read_window = physicalImageWindow;
  leaves.display_source = physicalDisplaySource;
  leaves.framebuffer_view = [](uint32_t* size) { return physicalFramebuffer(*sessionChecks.renderer, size); };
  leaves.fonts_prewarm_begin = [](XpEpubPrewarm* storage) {
    return physicalPrewarmBegin(*sessionChecks.renderer, storage);
  };
  leaves.fonts_prewarm_finish_scan = physicalPrewarmFinish;
  leaves.fonts_prewarm_drop = physicalPrewarmDrop;
  leaves.image_clear_failures = FrameImageBlock::clearRenderFailures;
  leaves.image_release_cache = FrameImageBlock::releaseRenderCache;
  leaves.paint_arena = [](const XpEpubPageView* view, int32_t font, int32_t left, int32_t top, uint8_t mode) {
    assert(!retirement_fixture::modelDepth && view && font == 24 && left == 7 && top == 11);
    ++sessionChecks.paints;
    Page page(Page::Borrowed{}, view->arena, view->size, view->visible_offset);
    assert(page.visibleTextOffset == 37);
    switch (mode) {
      case 0:
        page.render(*sessionChecks.renderer, font, left, top);
        break;
      case 1:
        page.renderImages(*sessionChecks.renderer, font, left, top);
        break;
      case 2:
        page.renderWithImagePlaceholders(*sessionChecks.renderer, font, left, top);
        break;
      default:
        std::abort();
    }
  };
  leaves.paint_status = [](const XpEpubStatus* status) {
    assert(!retirement_fixture::modelDepth && status && status->page == 1 && status->pages == 1);
    ++sessionChecks.statuses;
  };
  leaves.log_enabled = [](uint8_t) -> uint8_t { return 0; };
  renderer.frameStride = 100;
  renderer.onDisplay = +[] {
    if (display.source) {
      const auto& source = *display.source;
      assert(source.paint(source.ctx, source.scratch, 0, 80) == 0);
      assert(source.paint(source.ctx, source.scratch, 0, 80) == 0);
    }
  };
  auto run = [&](size_t fail, bool reject) {
    frameChecks::reset();
    sessionChecks = {};
    sessionChecks.renderer = &renderer;
    sessionChecks.failAt = fail;
    display.reject = reject;
    const auto rendered = xp_epub_test_session_render(&sessionMemory, &leaves, &sessionRuntime, wire,
#if defined(XP_STRIP_RENDER) && XP_STRIP_RENDER
                                                      1
#else
                                                      0
#endif
    );
    assert(!sessionChecks.handles && !display.source && !frameChecks::window);
#if defined(XP_STRIP_RENDER) && XP_STRIP_RENDER
    assert(!renderer.framePlan);
#endif
    assert(renderer.frameCache.scopes == 0 && !retirement_fixture::modelDepth);
    for (auto* pointer : sessionChecks.live) assert(!pointer);
    if (fail == SIZE_MAX) assert(rendered == 2 && sessionChecks.paints && sessionChecks.statuses >= 2);
    return sessionChecks.requests;
  };
  const size_t attempts = run(SIZE_MAX, false);
  if (faults)
    for (size_t fail = 0; fail < attempts; ++fail) run(fail, false);
  run(SIZE_MAX, true);
  renderer.frameStride = 60;
  renderer.onDisplay = nullptr;
  display.reject = false;
}
