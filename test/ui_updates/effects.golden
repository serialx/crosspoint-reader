CASE ota-check
enter OtaUpdate
DBG OTA Turning on WiFi...
wifi.mode 1
DBG OTA Launching WifiSelectionActivity...
push WifiSelection
DBG OTA WiFi connected, checking for update
render.wait
ota.check
ota.newer
DBG OTA No new update available
state 4 sleep 0
paint.clear
paint.header 0 12 528 36 STR_UPDATE | 
paint.center 384 1 STR_NO_UPDATE
paint.hints STR_BACK |  |  | 
panel.fast
exit OtaUpdate
wifi.disconnect 0
delay 30
restart.silent
CASE ota-check
enter OtaUpdate
DBG OTA Turning on WiFi...
wifi.mode 1
DBG OTA Launching WifiSelectionActivity...
push WifiSelection
DBG OTA WiFi connected, checking for update
render.wait
ota.check
ota.newer
popup STR_NEW_UPDATE 2 1 STR_CANCEL STR_UPDATE
render.request 0
state 2 sleep 0
paint.clear
paint.header 0 12 528 36 STR_UPDATE | 
paint.text 16 132 STR_CURRENT_VERSIONbaseline
paint.text 16 164 STR_NEW_VERSIONnew
paint.popup 1
panel.fast
exit OtaUpdate
wifi.disconnect 0
delay 30
restart.silent
