CASE cache-clear
enter ClearCache
popup STR_CLEAR_READING_CACHE 2 0 STR_CANCEL STR_CLEAR_BUTTON
popup.message STR_CLEAR_CACHE_WARNING_2
render.request 0
DBG CLEAR_CACHE User confirmed, starting cache clear
render.wait
DBG CLEAR_CACHE Clearing cache...
directory.open /.crosspoint
file.next epub_good
file.name epub_good
DBG CLEAR_CACHE Removing cache: /.crosspoint/epub_good
file.close epub_good
directory.remove /.crosspoint/epub_good
file.next txt_bad
file.name txt_bad
DBG CLEAR_CACHE Removing cache: /.crosspoint/txt_bad
file.close txt_bad
directory.remove /.crosspoint/txt_bad
ERR CLEAR_CACHE Failed to remove: /.crosspoint/txt_bad
file.next xtc_ok
file.name xtc_ok
DBG CLEAR_CACHE Removing cache: /.crosspoint/xtc_ok
file.close xtc_ok
directory.remove /.crosspoint/xtc_ok
file.next settings
file.name settings
file.close settings
file.next epub_file
file.name epub_file
file.close epub_file
file.close root
